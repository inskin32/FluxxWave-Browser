"""
Flux AI - Modulo ufficiale completo per FluxxWave Browser
Pronto per l'avvio tramite IDLE Python e la pubblicazione su GitHub.

Descrizione: Interfaccia autonoma che si collega direttamente alle API ufficiali
             di OpenAI (ChatGPT) usando il modello gpt-4o-mini.
             Non richiede JavaScript, CSS o comandi manuali da terminale.
"""

import os
import webbrowser
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.parse import parse_qs
from openai import OpenAI

# ==========================================
# CONFIGURAZIONE CHIAVE API OPENAI
# ==========================================
# Inserisci la tua chiave API segreta di OpenAI tra le virgolette qui sotto.
CHIAVE_OPENAI = "LA_TUA_CHIAVE_API_OPENAI_QUI"

# ==========================================
# INTERFACCIA HTML INIZIALE (Nativa del Browser)
# ==========================================
HTML_INTERFACCIA = """<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>Flux AI - Chat</title>
</head>
<body>

    <h1>⚡ Flux AI</h1>
    <p>Assistente ufficiale integrato in FluxxWave Browser (Powered by ChatGPT)</p>
    <hr>

    <!-- Il modulo HTML nativo invia il testo direttamente a Python -->
    <form action="/chiedi-flux" method="POST">
        <label for="domanda">Cosa vuoi chiedere a Flux AI?</label><br><br>
        <input type="text" id="domanda" name="testo_utente" placeholder="Scrivi una domanda..." required size="50">
        <button type="submit">Invia a Flux AI</button>
    </form>

</body>
</html>"""

# ==========================================
# MOTORE LOGICO PYTHON (GESTIONE SERVER INTERNO)
# ==========================================
class GestoreFluxAI(BaseHTTPRequestHandler):
    
    def log_message(self, format, *args):
        return  # Nasconde i log tecnici nella console di IDLE per non fare confusione

    # 1. Mostra la schermata iniziale del browser all'apertura
    def do_GET(self):
        if self.path == "/":
            self.send_response(200)
            self.send_header("Content-type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(HTML_INTERFACCIA.encode('utf-8'))

    # 2. Riceve la domanda, interroga ChatGPT e restituisce la risposta
    def do_POST(self):
        if self.path == "/chiedi-flux":
            # Estrae e decodifica i dati inviati dal modulo HTML
            lunghezza_dati = int(self.headers['Content-Length'])
            dati_ricevuti = self.rfile.read(lunghezza_dati).decode('utf-8')
            parametri = parse_qs(dati_ricevuti)
            
            # Legge la stringa inserita dall'utente nella casella
            testo_utente = parametri.get('testo_utente', [''])[0]
            testo_ia = ""

            try:
                # Controllo di sicurezza prima di inviare la richiesta su internet
                if "LA_TUA_CHIAVE" in CHIAVE_OPENAI or CHIAVE_OPENAI == "":
                    testo_ia = "Errore: Non hai inserito la tua chiave API OpenAI all'interno del codice Python. Modifica il file per continuare."
                else:
                    # Chiama i server ufficiali di OpenAI usando la loro libreria ufficiale
                    client = OpenAI(api_key=CHIAVE_OPENAI)
                    risposta = client.chat.completions.create(
                        model="gpt-4o-mini", # Modello fisso, velocissimo ed economico
                        messages=[
                            {
                                "role": "system", 
                                "content": "Tu sei Flux AI, l'assistente ufficiale integrato nel browser FluxxWave. Rispondi sempre in modo diretto, utile e dritto al punto."
                            },
                            {"role": "user", "content": testo_utente}
                        ]
                    )
                    testo_ia = risposta.choices.message.content

            except Exception as e:
                testo_ia = f"Errore di comunicazione con i server di ChatGPT: {str(e)}"

            # 3. Genera e restituisce la pagina dei risultati con la chat in cascata
            self.send_response(200)
            self.send_header("Content-type", "text/html; charset=utf-8")
            self.end_headers()
            
            html_risposta = f"""<!DOCTYPE html>
            <html>
            <head>
                <meta charset="UTF-8">
                <title>Flux AI - Risposta</title>
            </head>
            <body>
                <h1>⚡ Flux AI</h1>
                <p><b>La tua domanda:</b> {testo_utente}</p>
                <p><b>Risposta di Flux AI:</b></p>
                <blockquote style="background: #eef2f3; padding: 15px; border-left: 5px solid #00adb5;">
                    {testo_ia}
                </blockquote>
                <hr>
                
                <!-- Modulo nativo integrato sotto per poter continuare a chattare all'infinito -->
                <form action="/chiedi-flux" method="POST">
                    <input type="text" name="testo_utente" placeholder="Fai un'altra domanda..." required size="50">
                    <button type="submit">Invia</button>
                </form>
                <br>
                <p><a href="/">← Svuota la conversazione e torna alla schermata iniziale</a></p>
            </body>
            </html>"""
            
            self.wfile.write(html_risposta.encode('utf-8'))

# ==========================================
# AVVIO AUTOMATICO SENZA APRIRE IL TERMINALE
# ==========================================
if __name__ == "__main__":
    porta_locale = 8080
    indirizzo_server = '127.0.0.1'
    
    # Crea il server locale privato sulla porta 8080
    server_flux = HTTPServer((indirizzo_server, porta_locale), GestoreFluxAI)
    
    # Apre in automatico la finestra grafica di Flux AI dentro il browser
    webbrowser.open(f"http://{indirizzo_server}:{porta_locale}")
    
    # Mantiene l'applicazione in ascolto per ricevere le domande
    server_flux.serve_forever()
